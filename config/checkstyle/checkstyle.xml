<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Project override of the bundled cleancode-checkstyle.xml.
  - LineLength.max bumped to 140 — OpenRewrite recipe call sites and method
    signatures are intrinsically wide.
  - severity = error: findings fail the build (gate, not advisory).
  - FileLength + MethodLength suppressed under src/test and src/integrationTest:
    integration-test method bodies legitimately spell out before/after fixtures
    that would lose readability if split.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <module name="SuppressionSingleFilter">
        <property name="checks" value="FileLength|MethodLength"/>
        <property name="files" value="[\\/]src[\\/](test|integrationTest)[\\/]"/>
    </module>
    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="NeedBraces"/>
        <module name="EmptyBlock"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="FinalLocalVariable"/>
        <module name="ParameterNumber">
            <property name="max" value="4"/>
        </module>
        <module name="MethodLength">
            <property name="max" value="50"/>
        </module>
    </module>
    <module name="FileLength">
        <property name="max" value="150"/>
    </module>
    <module name="LineLength">
        <property name="max" value="140"/>
    </module>
</module>
